<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrestaITESHU.Pages.InventarioPage">
    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="15">
            <Grid HeightRequest="50"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="logoo.png"
                       WidthRequest="900"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        WidthRequest="150"
                        Text="Regresar"
                        Clicked="Button_Clicked"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />
            </Grid>
            <Label Text="Inventario"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="Green"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="Agregar"
                        Clicked="OnAgregarClicked"
                        BackgroundColor="#0F1785"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />
                <SearchBar Grid.Column="2"
                           Placeholder="Buscar..."
                           TextChanged="SearchBar_TextChanged" />
                <Button Grid.Column="4"
                        Text="Expediente"
                        Clicked="Expediente_Clicked"
                        BackgroundColor="#C6C1C1"
                        TextColor="Black"
                        FontAttributes="Bold" />
            </Grid>

            <Frame BorderColor="LightGray"
                   Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   IsVisible="{Binding MostrarFormulario}">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Nombre"
                           FontAttributes="Bold" />

                    <Entry Placeholder="Nombre del material"
                           Text="{Binding Nombre}" />

                    <Label Text="Descripción"
                           FontAttributes="Bold" />

                    <Editor Placeholder="Descripción"
                            HeightRequest="100"
                            Text="{Binding Descripcion}" />

                    <Label Text="Cantidad"
                           FontAttributes="Bold" />

                    <Entry Placeholder="Cantidad"
                           Keyboard="Numeric"
                           Text="{Binding Cantidad}" />

                    <Label Text="Laboratorio"
                           FontAttributes="Bold" />

                    <Picker Title="Seleccionar laboratorio"
                            ItemsSource="{Binding LaboratoriosLista}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding LaboratorioSeleccionado}" />

                    <HorizontalStackLayout>
                        <Label Text="Activo"
                               VerticalOptions="Center" />
                        <Switch IsToggled="{Binding Activo}" />
                    </HorizontalStackLayout>
                    
                    <Button Text="Guardar"
                                Clicked="OnGuardarClicked"
                                BackgroundColor="#28A745"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HorizontalOptions="FillAndExpand" />

                    <Button Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            BackgroundColor="Red"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HorizontalOptions="FillAndExpand" />

                </VerticalStackLayout>

            </Frame>
            <CollectionView ItemsSource="{Binding Inventarios}">

                <CollectionView.Header>

                    <Grid BackgroundColor="Red"
                          Padding="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="Nombre"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="1"
                               Text="Descripción"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="2"
                               Text="Cantidad"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="3"
                               Text="Laboratorio"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="4"
                               Text="Activo"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="5"
                               Text="Acciones"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                    </Grid>

                </CollectionView.Header>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame BorderColor="Gray"
                               Padding="5"
                               Margin="0,0,0,2">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding Nombre}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding Descripcion}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding Cantidad}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="3"
                                       Text="{Binding NombreLaboratorio}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="4"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">

                                    <Label.Triggers>

                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Activo}"
                                                     Value="True">

                                            <Setter Property="Text"
                                                    Value="✔" />

                                            <Setter Property="TextColor"
                                                    Value="Green" />

                                        </DataTrigger>

                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Activo}"
                                                     Value="False">

                                            <Setter Property="Text"
                                                    Value="✖" />

                                            <Setter Property="TextColor"
                                                    Value="Red" />

                                        </DataTrigger>

                                    </Label.Triggers>

                                </Label>

                                <HorizontalStackLayout Grid.Column="5"
                                                       Spacing="10">

                                    <Button Text="Editar"
                                            WidthRequest="100"
                                            Clicked="OnEditarClicked"
                                            BackgroundColor="#FFC107"
                                            TextColor="White" />

                                    <Button Text="Eliminar"
                                            WidthRequest="100"
                                            Clicked="OnEliminarClicked"
                                            BackgroundColor="#DC3545"
                                            TextColor="White" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>