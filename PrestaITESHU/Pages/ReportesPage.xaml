<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrestaITESHU.Pages.ReportesPage">
    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- LOGO Y BOTON -->
            <Grid HeightRequest="50"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="logoo.png"
                       WidthRequest="900"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Regresar"
                        Clicked="Regresar_Clicked"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="45" />

            </Grid>

            <!-- TITULO -->

            <VerticalStackLayout Padding="20"
                                     Spacing="20">

                    <Label Text="Reportes"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="Green"
                           HorizontalOptions="Center" />

                    <Button Text="Generar Reportes"
                            Clicked="GenerarReportes_Clicked"
                            BackgroundColor="Green"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="55" />

                <CollectionView ItemsSource="{Binding Reportes}">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Frame BorderColor="Gray"
                                   Padding="10"
                                   Margin="0,0,0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="{Binding NombreArchivo}"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold" />

                                    <Button Grid.Column="1"
                                            Text="Abrir"
                                            BackgroundColor="#0F1785"
                                            TextColor="White"
                                            Clicked="AbrirReporte_Clicked" />

                                </Grid>

                            </Frame>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>